{
  "services": {
    "crisis-connect-backend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "pip install -r backend/requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "crisis-connect-backend"
      }
    }
  ]
}