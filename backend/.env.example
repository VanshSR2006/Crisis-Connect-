# Environment mode: development | production
ENVIRONMENT=development

# Database Connection URL (PostgreSQL for production; SQLite for local dev)
DATABASE_URL=sqlite:///./crisis_connect.db

# JWT Configuration Secrets
JWT_SECRET_KEY=super-secret-temporary-key-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Allowed CORS origins for FastAPI middleware
FRONTEND_ORIGIN=*

# Redis connection string (Required in production)
REDIS_URL=redis://localhost:6379/0
